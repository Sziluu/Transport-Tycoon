<Window x:Class="transport_tycoon_viewlayer.View.VehicleShopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:transport_tycoon_viewlayer.View"
        mc:Ignorable="d"
    Title="Vehicle Shop" Width="650" Height="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="#222">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="VEHICLE SHOP" FontSize="22" FontWeight="Bold"
               Foreground="#4caf50" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vehicle list -->
            <Border Grid.Column="0" Background="#333" CornerRadius="5" Margin="0,0,10,0">
                <ListBox x:Name="VehicleList" Background="Transparent" Foreground="White"
                     BorderThickness="0" FontSize="13"
                     SelectionChanged="VehicleList_SelectionChanged">
                    <ListBoxItem Content="Bus (Passengers)" Tag="Bus"/>
                    <ListBoxItem Content="Iron Ore Transporter" Tag="IronOreTransporter"/>
                    <ListBoxItem Content="Iron Transporter" Tag="IronTransporter"/>
                    <ListBoxItem Content="Coal Transporter" Tag="CoalTransporter"/>
                    <ListBoxItem Content="Wood Transporter" Tag="WoodTransporter"/>
                    <ListBoxItem Content="Paper Transporter" Tag="PaperTransporter"/>
                    <ListBoxItem Content="Wheat Transporter" Tag="WheatTransporter"/>
                    <ListBoxItem Content="Bread Transporter" Tag="BreadTransporter"/>
                </ListBox>
            </Border>

            <!-- Vehicle details -->
            <Border Grid.Column="1" Background="#333" CornerRadius="5" Padding="18">
                <StackPanel>
                    <!-- Color-coded vehicle preview -->
                    <Border x:Name="VehiclePreviewBorder" Background="#444" 
                        Height="100" CornerRadius="5" Margin="0,0,0,12">
                        <Grid>
                            <Rectangle x:Name="VehicleColorBox" Width="60" Height="35"
                                   RadiusX="5" RadiusY="5" Fill="Gray"
                                   Stroke="White" StrokeThickness="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VehicleTypeLabel" Text=""
                                   FontSize="11" Foreground="#aaa"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,4">
                        <TextBlock Text="Size:" Foreground="#aaa" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <RadioButton x:Name="SizeSmall" Content="Small" Foreground="White"
                                     GroupName="Size" Margin="0,0,12,0" FontSize="12"
                                     Checked="Size_Changed"/>
                            <RadioButton x:Name="SizeMedium" Content="Medium" Foreground="White"
                                     GroupName="Size" IsChecked="True" Margin="0,0,12,0" FontSize="12"
                                     Checked="Size_Changed"/>
                            <RadioButton x:Name="SizeBig" Content="Large" Foreground="White"
                                     GroupName="Size" FontSize="12"
                                     Checked="Size_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="SpeedInfoLabel" Text="Speed: -" Foreground="#bbb" 
                           FontSize="13" Margin="0,6"/>
                    <TextBlock x:Name="CapacityInfoLabel" Text="Capacity: -" Foreground="#bbb" 
                           FontSize="13" Margin="0,4"/>
                    <TextBlock x:Name="MaterialInfoLabel" Text="Material: -" Foreground="#bbb" 
                           FontSize="13" Margin="0,4"/>
                    <TextBlock x:Name="PriceInfoLabel" Text="Price: -" Foreground="#ffeb3b" 
                           FontSize="17" FontWeight="Bold" Margin="0,8"/>
                    <TextBlock x:Name="BalanceInfoLabel" Text="" Foreground="#4caf50" 
                           FontSize="12" Margin="0,4"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Buy" Width="110" Height="38" Margin="0,0,10,0"
                FontSize="15" FontWeight="Bold" Click="Buy_Click"
                Background="#4caf50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Cancel" Width="90" Height="38"
                FontSize="15" Click="Cancel_Click"
                Background="#555" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
